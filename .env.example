# Copy this file to .env and fill in your Supabase project credentials
# (Project Settings -> API in the Supabase dashboard) to switch the app
# from local seed data to a live database, and to enable sign-in/sign-up.
# See supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay publishable Key ID (safe to expose in the browser — this is NOT
# the secret). Get it from the Razorpay Dashboard -> Settings -> API Keys.
# The matching RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET must also be set as
# secrets on the `razorpay` Supabase Edge Function — see README.md.
VITE_RAZORPAY_KEY_ID=
